<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for Bytemeter.app/Contents/Info.plist. install.sh fills in the two
  placeholders from the VERSION file at build time. Edit VERSION, not this file,
  to change the version.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Bytemeter</string>
  <key>CFBundleDisplayName</key><string>Bytemeter</string>
  <key>CFBundleIdentifier</key><string>io.github.adi-debug-source.bytemeter</string>
  <key>CFBundleExecutable</key><string>Bytemeter</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__BUILD__</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- A menu bar app: no Dock icon and no app menu. -->
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <!--
    Location Services, asked for only when network name recording is switched
    on in Preferences: macOS gives an app the Wi-Fi network name only with this
    permission. The app calls requestWhenInUseAuthorization, which macOS
    ignores unless NSLocationWhenInUseUsageDescription is present.
    NSLocationUsageDescription is the older macOS key for the same question,
    kept so the wording is the same whichever key a version of macOS reads.
  -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Bytemeter reads the name of the Wi-Fi network this Mac is connected to, so it can keep usage on one network separate from another, such as a hotspot. macOS counts a network name as location information. Bytemeter does not use your location for anything else.</string>
  <key>NSLocationUsageDescription</key>
  <string>Bytemeter reads the name of the Wi-Fi network this Mac is connected to, so it can keep usage on one network separate from another, such as a hotspot. macOS counts a network name as location information. Bytemeter does not use your location for anything else.</string>
</dict>
</plist>
